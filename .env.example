# ---- Database ----
DATABASE_URL=mysql+asyncmy://async_scheduler:async_scheduler@127.0.0.1:3306/async_scheduler

# ---- Redis / distributed queue ----
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_TYPE=redis
LOCK_TYPE=redis
REGISTRY_TYPE=memory
LEASE_TTL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10

# ---- Logging ----
LOG_FORMAT=json
LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0

# Set per process/service
# SERVICE_NAME=scheduler-api
# NODE_ID=node-local-01
